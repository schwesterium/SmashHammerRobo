    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RimLight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 nNormal = normalize(Normal);\nfloat3 nViewDir = normalize(ViewDirection);\n\nRim = pow(1 - saturate(dot(nNormal, nViewDir)), RimPower);"
}

